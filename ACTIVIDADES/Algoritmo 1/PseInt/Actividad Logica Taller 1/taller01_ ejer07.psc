// Area de Rectángulo 
Algoritmo Area_Rectángulo
	Definir b, h Como Real
	Escribir "Digita el valor de la base: "
	Leer b
	Escribir "digita el valor de la altura: "
	Leer h
	ar = b*h
	Escribir "valor ingresaado son: "
	Escribir "el valor: " b," el valor: ", h
	Escribir "el resultado del rectangulo es: ", ar
FinAlgoritmo
