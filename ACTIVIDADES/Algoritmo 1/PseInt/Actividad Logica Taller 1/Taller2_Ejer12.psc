Algoritmo conve_Metroo
	Definir mt Como Real
	Escribir "Ingresar la cantidad de metros: "
	leer mt
	
	kilo = mt/1000
	hecto = mt/100
	deca = mt/10
	deci = mt * 1
	cent = mt * 100
	mll = mt * 1000
	Escribir "Valor ingresado es: ", mt
	Escribir "el resultado de cada conversion son: kilómetro: ", kilo,  " " "Hectómetro: ", hecto, " " "Decámetro: ", deca, " " "Decimetro: ", deci, " " "centímetro: ", cent, " " "Milímetro: ", mll
FinAlgoritmo
