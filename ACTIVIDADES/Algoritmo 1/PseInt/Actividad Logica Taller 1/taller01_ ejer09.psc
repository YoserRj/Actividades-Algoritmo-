Algoritmo areaTrapecio
	Definir bmen, bmay, h Como Real
	Escribir "Digite el valor de la base menor: "
	Leer bmen
	Escribir "Digite el valor de la base mayor: "
	leer bmay
	Escribir "Digite el valor de la altura: "
	leer h
	atrap = (bmen * bmay)/2*h
	Escribir "los valores ingresados son: "
	Escribir bmen
	Escribir bmay
	Escribir h
	Escribir "el valor de area trapecio es: ", atrap
	
FinAlgoritmo
