Algoritmo area_rombo
	Definir dmen, dmay como real
	Escribir "Digite el numero de diagonal menos: "
	leer dmen
	Escribir "Digite el siguiente numero de diagonal mayor: "
	leer dmay
	armb = dmen * dmay /2
	Escribir "los valores diagonal menor y diagonal mayor son: ",  "diagonal menor: ", dmen,"" ," ", "diagonal mayor:  ",dmay
	Escribir "el resultado de area rombo: ",armb
	
	
	
FinAlgoritmo
