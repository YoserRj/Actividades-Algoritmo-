Algoritmo valorNas
	Definir N como real
	
	Escribir "escribr un numero del 1 hacia adelante: "
	leer N
	
	Para i <- 1 hasta N Con Paso 1 Hacer
		Escribir i
	FinPara
	
	Escribir " "
	
	Escribir "El ciclo Repetir"
	
	Definir  u Como Real
	u = 1
	Escribir "escribe un número: "
	leer N
	Repetir
		Escribir u
		u = u +1
	Hasta Que u > N
	
	Escribir " "
	
	Escribir "el ciclo Mientras"
	
	Definir I Como Real
	I = 1
	Escribir "escibe un Número: "
	leer N
	Mientras I <= N Hacer
		Escribir I
		I = I +1
	FinMientras
FinAlgoritmo
