// imprimir Sena
Algoritmo imSena
	Definir iter, itera Como Entero
	
	Para iterador <- 1 Hasta 5 Con Paso 1 Hacer
		Escribir "Sena"
	FinPara
	
	Escribir "---------------"
	Escribir "CICLO MIENTRAS"
	
	Mientras iter <= 5 Hacer
		Escribir "SenA"
		iter = iter + 1
	FinMientras
	
	Escribir "________"
	Escribir "Repetir"
	itera = 1 
	Repetir
		Escribir "SENA"
		itera = itera +1
	Hasta Que itera > 5
FinAlgoritmo
