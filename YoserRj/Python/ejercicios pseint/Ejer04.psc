// ingresr un numero, determina si es positivo, o negativo o nulo
Algoritmo Ejer04
	Definir num como entero
	
	Escribir "digita un numero: "
	leer num
	
	si num > 0 Entonces
		Escribir "el numero es positivo."
	sino
		si num < 0 Entonces
			Escribir "el numero es negativo."
		SiNo
			Escribir "el numero es nulo."
		FinSi
	FinSi
	
FinAlgoritmo
